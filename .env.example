# uni-auth Environment Configuration Example
# Copy this file to .env in this directory:
#   cp .env.example .env

# Server port and base authentication endpoint
PORT=3000
AUTH_BASE_URL=http://localhost:3000/api/auth

# 32+ character secret used for token HMAC signatures
UNI_AUTH_SECRET=uni-auth-super-secret-development-key-32-chars

# SQLite database path (use sqlite::memory: for volatile test storage)
DATABASE_URL=sqlite::memory:

# ==============================================================================
# Google OAuth 2.0 Credentials
# Create a "Web application" in Google Cloud Console
# Authorised JavaScript origins:
#   - http://localhost:3000
#   - http://localhost:5173
# Authorised redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# GitHub OAuth Credentials (Optional)
# Create an OAuth App in GitHub Developer Settings
# Authorization callback URL:
#   - http://localhost:3000/api/auth/callback/github
# ==============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
